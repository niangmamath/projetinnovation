<%- include('partials/header') -%>

<div class="container mx-auto px-4 py-8">
  <div class="bg-white shadow-md rounded-lg p-8 max-w-4xl mx-auto">
    <h2 class="text-3xl font-bold mb-6 text-center text-green-700">Mon Empreinte Carbone</h2>

    <% if (typeof totalCarbonFootprint !== 'undefined' && totalCarbonFootprint > 0) { %>
      <div class="text-center bg-green-100 border-l-4 border-green-500 text-green-700 p-4 rounded-md mb-8">
        <p class="text-lg">Votre empreinte carbone totale pour tous vos vols est de :</p>
        <p class="text-4xl font-bold"><%= totalCarbonFootprint.toFixed(2) %> kg CO₂e</p>
        <p class="text-sm mt-2">Cela équivaut à un trajet d'environ <%= (totalCarbonFootprint * 5).toFixed(0) %> km en voiture.</p>
      </div>

      <h3 class="text-2xl font-bold mt-8 mb-4 text-gray-800">Détail de vos vols :</h3>
      <div class="space-y-4">
        <% bookings.forEach(booking => { %>
          <div class="p-4 border rounded-lg flex justify-between items-center">
            <div>
              <p class="font-bold text-lg"><%= booking.flight.from %> → <%= booking.flight.to %></p>
              <p class="text-sm text-gray-600">Classe : <%= booking.class.charAt(0).toUpperCase() + booking.class.slice(1) %></p>
            </div>
            <div class="text-right">
              <p class="font-semibold text-lg"><%= booking.carbonFootprint.toFixed(2) %> kg CO₂e</p>
            </div>
          </div>
        <% }); %>
      </div>

    <% } else { %>
      <div class="text-center text-gray-500 mt-8">
        <p>Vous n'avez pas encore de vols réservés.</p>
        <a href="/flights" class="text-green-600 hover:underline">Commencez à chercher un vol</a> pour voir votre impact.
      </div>
    <% } %>

  </div>
</div>

<%- include('partials/footer') -%>
